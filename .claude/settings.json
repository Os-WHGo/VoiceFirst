{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/authz/authz.py\" session",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/authz/authz.py\" prompt",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/authz/authz.py\" pretool",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "ExitPlanMode",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/authz/authz.py\" plan",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "permissions": {
    "ask": [
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git push --force-with-lease *)",
      "Bash(git push * main)",
      "Bash(git push * master)",
      "Bash(git push * HEAD:main)",
      "Bash(git push * HEAD:master)",
      "Bash(git reset --hard *)",
      "Bash(git clean *)",
      "Bash(rm -rf *)",
      "Bash(rm -fr *)",
      "Bash(npm publish *)",
      "Bash(pnpm publish *)",
      "Bash(yarn publish *)",
      "Bash(twine upload *)",
      "Bash(vercel --prod *)",
      "Bash(vercel deploy *)",
      "Bash(wrangler deploy *)",
      "Bash(firebase deploy *)",
      "Bash(terraform apply *)",
      "Bash(terraform destroy *)",
      "Bash(kubectl apply *)",
      "Bash(kubectl delete *)",
      "mcp__*__merge_pull_request",
      "mcp__*__create_deployment",
      "mcp__*__request_promote",
      "mcp__*__buy_domain",
      "mcp__*__send_message",
      "mcp__*__forward",
      "mcp__*__share_file",
      "mcp__*__publish*",
      "mcp__*__delete*"
    ]
  }
}
